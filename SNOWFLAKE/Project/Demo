use role accountadmin;
use database NUCOR_PRODREP;
use schema Revenue_report_Manager;

ALTER PIPE SNOWPIPELINE_2_AZURE_JSON SET PIPE_EXECUTION_PAUSED = FALSE;
COPY INTO RawCustomerData_Json FROM @Azure_Snowflake_Json
FILE_FORMAT = (TYPE = 'JSON')
ON_ERROR = 'CONTINUE';
ALTER PIPE SNOWPIPELINE_2_AZURE_JSON  REFRESH;
truncate table RAWCUSTOMERDATA_JSON;


COPY INTO RawRevenueData_csv 
FROM @Aws_Snowflake_csv
FILE_FORMAT = (TYPE = 'CSV') 
ON_ERROR = 'CONTINUE';

ALTER PIPE SNOWPIPELINE_2_AWS_S3   REFRESH;
truncate table RawRevenueData_csv;

SELECT * FROM TABLE(information_schema.query_history())
WHERE query_text ILIKE '%COPY INTO%';


